
---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase
  titulo="Nossa Equipe"
  descricao="Conheça as pessoas que fazem a Nova Tech acontecer."
>
  <section class="secao">
    <div class="container">
      <header class="cabecalho-secao">
        <h1>Nossa Equipe Técnica</h1>
        <p>
          Conheça as profissionais responsáveis por transformar ideias
          em soluções tecnológicas.
        </p>
      </header>

      <div class="grid-equipe">
        {empresa.equipe.map((membro) => (
          <Cartao>
            <div class="card-membro-conteudo">
              <img
                src={membro.foto}
                alt={membro.alt}
                class="foto-perfil"
                width="140"
                height="140"
              />

              <div class="info-membro">
                <h3>{membro.nome}</h3>
                <span class="cargo">{membro.cargo}</span>
                <p class="descricao-membro">{membro.descricao}</p>
              </div>
            </div>
          </Cartao>
        ))}
      </div>
    </div>
  </section>
</LayoutBase>

<style>
  .cabecalho-secao {
    text-align: center;
    margin-bottom: 3rem;
  }

  .cabecalho-secao h1 {
    margin-bottom: 1rem;
  }

  .grid-equipe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .card-membro-conteudo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .foto-perfil {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1.5rem;
  }

  .info-membro h3 {
    margin-bottom: 0.5rem;
  }

  .cargo {
    display: inline-block;
    color: var(--cor-secundaria);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
  }

  .descricao-membro {
    font-size: 0.95rem;
    color: var(--cor-texto-secundario);
    margin-bottom: 0;
  }
</style>
